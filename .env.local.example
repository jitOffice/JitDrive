# Copy to .env.local and fill real values. NEVER commit .env.local.
JITWORD_API_BASE=https://inner.jitword.com/api/v1
JITWORD_EDITOR_URL=https://inner.jitword.com/px-editor
JITWORD_TENANT_KEY=<your tenantKey>
JITWORD_PROVIDER_KEY=<your providerKey>
JITWORD_CLIENT_ID=<your clientId>
JITWORD_CLIENT_SECRET=<your clientSecret>

DEMO_PUBLIC_ORIGIN=

# ---- User system (SQLite via Prisma; swap provider+url to move to Postgres) ----
# Relative to prisma/schema.prisma ⇒ resolves to <project>/data/jitdrive.db
DATABASE_URL="file:../data/jitdrive.db"
# HMAC key for the signed session cookie — use a long random string in prod.
SESSION_SECRET=<long-random-secret>
# Default invite code(s) seeded on first run (comma-separated).
DEMO_INVITE_CODE=JITDRIVE-DEMO
# Shared password for the seeded demo accounts.
DEMO_USER_PASSWORD=demo1234

# ---- v0.5.3 · S14 回收站到期自动清理 ----
# Bearer token for POST /api/internal/reap (external cron hook). If unset the
# endpoint returns 503 (disabled) rather than running unauthenticated purges.
CRON_SECRET="change-me-reap-hook-secret"
# Days a trashed item is kept before the sweep permanently purges it (UI: 30).
TRASH_RETENTION_DAYS="30"
